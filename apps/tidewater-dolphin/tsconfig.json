{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@bodyarcade/body-input": ["../../packages/body-input/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
