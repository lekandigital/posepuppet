{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@bodyarcade/body-input": ["../../packages/body-input/src/index.ts"],
      "@bodyarcade/pose-runtime": ["../../packages/pose-runtime/src/index.ts"],
      "@bodyarcade/pose-hud": ["../../packages/pose-hud/src/index.ts"],
      "@bodyarcade/world-data": ["../../packages/world-data/src/index.ts"]
    }
  },
  "include": ["src"]
}
